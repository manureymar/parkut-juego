{
  "name": "parkut-juego",
  "version": "0.5.0",
  "description": "Jumping in the City: parkour por azoteas, peatones animados y ciudad offline para Android.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node nivel-01/scripts/server.mjs",
    "assets": "python3 nivel-01/scripts/restore-originals.py && node nivel-01/scripts/prepare-assets.mjs && node nivel-01/scripts/prepare-colliders.mjs && npm run assets:city",
    "vendor": "node nivel-01/scripts/vendor.mjs",
    "test": "node nivel-01/scripts/test-physics.mjs && node nivel-01/scripts/test-traversal.mjs && node nivel-01/scripts/test-game.mjs && node nivel-01/scripts/test-context-game.mjs",
    "restore": "python3 nivel-01/scripts/restore-originals.py",
    "test:animation": "node nivel-01/scripts/test-animation.mjs",
    "test:v03": "node nivel-01/scripts/test-traffic.mjs && node nivel-01/scripts/test-v03.mjs",
    "assets:city": "python3 nivel-01/scripts/restore-city-originals.py && node nivel-01/scripts/prepare-city-assets.mjs && node nivel-01/scripts/prepare-city-buildings.mjs",
    "assets:pedestrians": "python3 nivel-01/scripts/restore-pedestrians.py && node nivel-01/scripts/prepare-pedestrians.mjs",
    "test:pedestrians": "node nivel-01/scripts/test-pedestrians.mjs",
    "test:v04": "node nivel-01/scripts/test-city-v04.mjs",
    "assets:parkour": "python3 nivel-01/scripts/restore-parkour.py && node nivel-01/scripts/prepare-parkour.mjs",
    "test:v05": "node nivel-01/scripts/test-grips-v05.mjs && node nivel-01/scripts/test-parkour-v05.mjs && node nivel-01/scripts/test-route-v05.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manureymar/parkut-juego.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/manureymar/parkut-juego/issues"
  },
  "homepage": "https://github.com/manureymar/parkut-juego#readme",
  "dependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "meshoptimizer": "^0.24.0",
    "sharp": "^0.34.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "playwright": "^1.51.1"
  },
  "private": true
}
